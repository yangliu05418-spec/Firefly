* text=auto

# Runtime and deployment files must stay LF even when the repository is
# checked out on Windows. A CRLF shebang previously broke production backups.
*.sh text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
