{
  "name": "firefly-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "worker": "node dist-server/worker.js",
    "media-worker": "node dist-server/media-worker.js",
    "tos:configure": "node dist-server/tos-admin.js",
    "tos:audit": "node dist-server/tos-audit.js",
    "history:clear": "node dist-server/clear-history.js",
    "test": "vitest run",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:server",
    "db:migrate": "node dist-server/migrate.js",
    "health:audit": "node dist-server/health-audit.js",
    "user:disable": "node dist-server/user-admin.js disable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@volcengine/tos-sdk": "^2.9.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "axios": "1.19.0"
  }
}
