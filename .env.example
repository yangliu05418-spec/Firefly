PORT=8090
PUBLIC_ORIGIN=https://firefly.kumadrama.com
REDIS_URL=redis://redis:6379
UPLOAD_DIR=/data/uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
DATABASE_PATH=/data/firefly.db
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
ALLOWED_EMAIL_DOMAIN=dokuai.tv
ARK_API_KEY=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_PROJECT=default
BYTEPLUS_OPENAPI_ENDPOINT=https://open.byteplusapi.com
PROVIDER_POLL_INTERVAL_MS=7000
GENERATION_CONCURRENCY=4
DISABLED_VIDEO_MODELS=
MAX_ACTIVE_UPLOADS_PER_USER=6
MEDIA_STORAGE_BACKEND=tos
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.bytepluses.com.cn
TOS_BUCKET=drama-firefly
TOS_PREVIEW_TTL_SECONDS=7200
TOS_DOWNLOAD_TTL_SECONDS=43200
TOS_INPUT_RETENTION_DAYS=7
TOS_UPLOAD_PART_SIZE=16777216
TOS_UPLOAD_CONCURRENCY=3
TOS_ARCHIVE_CONCURRENCY=3
TOS_ARCHIVE_PART_SIZE=5242880
TOS_ARCHIVE_PART_CONCURRENCY=4
# Provider临时源的全局读取预算；预览优先，避免与并行原片归档互相拖慢
TOS_SOURCE_READ_CONCURRENCY=8
TOS_URL_FETCH_ENABLED=false
TOS_REQUEST_TIMEOUT_MS=60000
TOS_UPLOAD_REQUEST_TIMEOUT_MS=180000
TOS_ARCHIVE_PART_REQUEST_TIMEOUT_MS=60000
TOS_ARCHIVE_PART_HEDGE_DELAY_MS=20000
TOS_TRANSCODE_DEADLINE_MS=600000
TOS_FETCH_DEADLINE_MS=30000
TOS_FETCH_MAX_WAIT_MS=60000
TOS_FETCH_POLL_INTERVAL_MS=3000
TOS_ARCHIVE_CHECKPOINT_TTL_SECONDS=86400
TOS_SOURCE_STREAM_TIMEOUT_MS=900000
TOS_PREVIEW_TRANSCODE_ENABLED=true
TOS_PREVIEW_CONCURRENCY=2
TOS_PREVIEW_MAX_BITRATE=3500000
# OpenRouter（图片生成）：逗号分隔多个 Key，服务端自动负载均衡与智能轮换
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REQUEST_TIMEOUT_MS=180000
# Canvas V2 在完成 schema 4 迁移且 canvas-worker 正常运行后启用。
CANVAS_V2_ENABLED=true
# 全量启用前可填写逗号分隔的企业邮箱进行账号灰度；全量启用后该配置不再限制访问。
CANVAS_V2_ALLOWLIST=
CANVAS_TEXT_MODEL=google/gemini-2.5-flash
# Atlas 独立编辑器与服务端 Agent。模型默认继承 CANVAS_TEXT_MODEL。
ATLAS_ENABLED=false
ATLAS_GENERATE_ENABLED=true
ATLAS_AGENT_ENABLED=false
ATLAS_AGENT_PHASE=off
ATLAS_MAX_UPLOAD_BYTES=8589934592
ATLAS_AGENT_MODEL=z-ai/glm-5.3-flash
ATLAS_AGENT_MAX_ROUNDS=8
ATLAS_AGENT_MAX_TOOL_CALLS=32
ATLAS_AGENT_REQUEST_TIMEOUT_MS=180000
# OPFS仅是本机加速层；任一开关关闭时对应产品面继续直连TOS。
LOCAL_MEDIA_CACHE_ENABLED=true
LOCAL_MEDIA_CACHE_STUDIO=true
LOCAL_MEDIA_CACHE_CANVAS=true
LOCAL_MEDIA_CACHE_ATLAS=true
# 上传源文件同写OPFS。关闭不影响TOS直传或生成。
LOCAL_MEDIA_UPLOAD_RESUME=true
# 重新编辑 V2 可独立关闭；任务引用归档关闭后，Media Worker 会保留待处理记录供重新启用时续传。
REEDIT_V2_ENABLED=true
TASK_REFERENCE_ARCHIVE_ENABLED=true
SHUTDOWN_GRACE_MS=30000
WORKER_READINESS_GRACE_MS=8000
FIREFLY_REVISION=development
FIREFLY_IMAGE_DIGEST=unknown
